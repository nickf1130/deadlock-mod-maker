{
  "name": "deadlock-sound-studio",
  "productName": "Deadlock Mod Maker",
  "private": true,
  "version": "1.0.1",
  "description": "Build validated VPK mods for Valve Deadlock",
  "license": "GPL-3.0-or-later",
  "author": "Deadlock Mod Maker contributors",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:1420 && tsc -p apps/electron/tsconfig.json && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:1420 electron .",
    "build": "npm run build:renderer && npm run build:electron && npm run verify:electron && npm run verify:version",
    "build:renderer": "vite build",
    "build:electron": "node scripts/clean-electron-build.mjs && tsc -p apps/electron/tsconfig.json",
    "verify:electron": "node scripts/verify-electron-build.mjs",
    "set-version": "node scripts/set-version.mjs",
    "version": "node scripts/set-version.mjs $npm_package_version && git add -A package.json package-lock.json python",
    "verify:version": "node scripts/verify-version.mjs",
    "python:sync": "node scripts/python-task.mjs sync",
    "build:python": "node scripts/python-task.mjs build",
    "dist": "npm run build && npm run build:python && electron-builder --config electron-builder.yml && node scripts/verify-release.mjs",
    "test": "vitest run",
    "test:python": "node scripts/python-task.mjs test",
    "audit:python": "node scripts/python-task.mjs audit",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run test && npm run test:python && npm run test:e2e",
    "typecheck": "tsc --noEmit && tsc -p apps/electron/tsconfig.json --noEmit"
  },
  "dependencies": {
    "electron-log": "^5.4.4"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0",
    "wavesurfer.js": "^7.12.11"
  }
}

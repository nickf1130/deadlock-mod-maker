{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../../dist-electron",
    "rootDir": ".",
    "types": ["node"],
    "noEmit": false,
    "sourceMap": true
  },
  "include": ["**/*.ts", "**/*.cts"],
  "exclude": ["**/*.test.ts"]
}
